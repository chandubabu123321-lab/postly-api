# ─────────────────────────────────────────────────────────────────────────────
# Postly API — environment variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=true
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5199

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — zero setup, single file):
DATABASE_URL=sqlite:///./postly.db

# Turso (production — swap this one line):
# DATABASE_URL=libsql://your-db.turso.io?authToken=YOUR_TOKEN

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Fernet key for encrypting OAuth tokens at rest (must be exactly 32 bytes):
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-32-byte-fernet-key

# ── Redis / Celery (optional) ────────────────────────────────────────────────
# Tasks run synchronously if Redis is unavailable — no need to install Redis for testing.
REDIS_URL=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local        # local | s3 | r2
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500

# ── Feature flags ────────────────────────────────────────────────────────────
# Keep all False during development — mock publishers run automatically.
# Set to True only after you have API keys AND app review approval from the platform.
ENABLE_INSTAGRAM_REAL=False
ENABLE_FACEBOOK_REAL=False
ENABLE_LINKEDIN_REAL=False
ENABLE_YOUTUBE_REAL=False
ENABLE_X_REAL=False

# ── Meta / Instagram + Facebook ──────────────────────────────────────────────
# Create a Meta Developer app at https://developers.facebook.com/
# Required permissions: pages_manage_posts, instagram_content_publish
META_APP_ID=
META_APP_SECRET=
FACEBOOK_APP_ID=           # same value as META_APP_ID
FACEBOOK_APP_SECRET=       # same value as META_APP_SECRET

# ── LinkedIn ─────────────────────────────────────────────────────────────────
# Create a LinkedIn app at https://www.linkedin.com/developers/
# Required scopes: openid, profile, w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Google / YouTube ─────────────────────────────────────────────────────────
# Create a Google Cloud OAuth 2.0 client at https://console.cloud.google.com/
# Enable: YouTube Data API v3
# Scopes: https://www.googleapis.com/auth/youtube.upload
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── X / Twitter ──────────────────────────────────────────────────────────────
# Create an X developer app at https://developer.x.com/
# OAuth 2.0 with PKCE, scopes: tweet.read tweet.write users.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=
